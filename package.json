{
  "name": "arkon-trading-app",
  "private": true,
  "version": "50.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node --env-file=.env dist/server.cjs",
    "start:prod": "set NODE_ENV=production&& node --env-file=.env dist/server.cjs",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --outfile=dist/server.cjs --format=cjs --packages=external",
    "build:server": "esbuild server.ts --bundle --platform=node --outfile=dist/server.cjs --format=cjs --packages=external",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tensorflow/tfjs": "^4.22.0",
    "archiver": "^8.0.0",
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "mathjs": "^15.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.8.1",
    "simple-statistics": "^7.8.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.0"
  }
}
