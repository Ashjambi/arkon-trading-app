# ============================================================
# ARKON Trading App — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# === REQUIRED ===
# Bridge Secret for authenticating MT5 ↔ Server communication.
# Generate a strong random string (e.g., openssl rand -hex 32)
BRIDGE_SECRET="your_bridge_secret_here"

# === OPTIONAL ===
# Runtime mode: "paper" (default, safe) or "live" (real trading)
# RUNTIME_MODE=paper

# Enable live RL execution (only works with RUNTIME_MODE=live)
# ALLOW_LIVE_RL=false

# CORS allowed origins (comma-separated)
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Server ports
# PORT=3000
# WS_PORT=3001
# HOST=127.0.0.1

